    "ATFL": { "name": "철벽의 방패", "desc": "앞에서 버티고, 맞고, 열어준다. 후반 한타에서 진가를 발휘하는 팀의 기둥." },
    "CSME": { "name": "정밀 저격수", "desc": "치고 빠지기의 달인. 리스크 없는 견제와 정교한 컨트롤로 상대를 말려 죽인다." },
    "CSML": { "name": "인내의 캐리머신", "desc": "초반의 굴욕은 견디면 그만. 성장이 끝나는 순간 한타를 혼자 정리한다." },
