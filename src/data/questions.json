    "CSFL": { "name": "꾸준한 성장러", "desc": "CS 하나하나가 곧 승리의 벽돌. 안정적인 운영으로 후반 캐리를 완성한다." },
    "CTME": { "name": "판짜는 전략가", "desc": "맵 전체를 읽고 팀의 움직임을 설계한다. 정교한 스킬로 아군의 길을 연다." },
